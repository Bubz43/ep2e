    {
      "_id": "uNVxevN3SaPmI3Pr",
      "name": "Non-Human Biochemistry",
      "type": "trait",
      "system": {
        "description": "<p>This trait is only available to biomorphs. This morph has substantial physiological and genetic differences from human morphs. Level 1 applies to non-human morphs. Level 2 applies to non-mammalian morphs. Apply a -10 modifier per level to Medicine Tests. Certain drugs, toxin, chemicals, or medical procedures may not work or may have a different effect (GM discretion). This trait may not be applied to morphs that do not come with it.</p>",
        "reference": "Eclipse Phase Second Edition p. 79",
        "restrictions": "",
