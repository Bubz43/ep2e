    {
      "_id": "XMV8ckIlpCLiJ31Z",
      "name": "Real World Naiveté",
      "type": "trait",
      "sort": 500000,
      "flags": {},
      "img": "icons/svg/mystery-man.svg",
      "effects": [],
      "system": {
        "description": "<p>You either have very limited personal experience with the real\n      (physical) world or have spent so much time in VR that your real-life\n      functioning is impaired. You lack an understanding of many physical properties, social cues, and other factors that most people take\n      for granted. This lack of common sense may lead you to misunderstand how a device works or misinterpret someone’s body language.\n      Once per game session, the GM may intentionally mislead you\n      when providing a description about some thing or social interaction.\n      This falsehood represents your misunderstanding of the situation\n      and should be roleplayed appropriately, even when the player is\n      aware of the character’s mistake.</p>",
        "reference": "Eclipse Phase Second Editon p. 80",
        "restrictions": "",
        "triggers": "",
        "source": "ego",
        "state": {
